# Isi hanya pada .env lokal, jangan masukkan kunci asli ke Git.
ANALYSIS_MAX_CONCURRENT=1
ANALYSIS_MAX_QUEUED=20
# ID akun admin (UUID), pisahkan dengan koma untuk beberapa akun.
# Kosong berarti semua endpoint pembaruan pasar manual ditolak.
ADMIN_USER_IDS=
OPENAI_API_KEY=
OPENAI_ENABLED=true
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
# Temperature applies to GPT-6 Luna only with reasoning effort none.
OPENAI_TEMPERATURE=1.15
# Batas gabungan token penalaran dan teks jawaban, bukan jumlah kata.
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_TIMEOUT_MS=120000
OPENAI_RETRY_ENABLED=false
OPENAI_MAX_RETRIES=3
OPENAI_RETURN_ERROR=false
# Kosong: tidak berpindah ke model lain saat GPT-6 Luna gagal.
OPENAI_FALLBACK_MODELS=
OPENAI_BACKOFF_BASE=2.0
OPENAI_BACKOFF_CAP=30.0
